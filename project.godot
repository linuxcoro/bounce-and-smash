; Engine configuration file.
; Bounce & Smash — arcade de físicas: lanza, rebota y destruye la torre.
; Hecho para exportarse con Godot 4.3 (ver .github/workflows/build-apk.yml).

config_version=5

[application]

config/name="Bounce & Smash"
config/description="Lanza una bola elástica, rebota y destruye la torre en hélice con impactos potentes."
config/version="1.0.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027451, 0.031373, 0.078431, 1)

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

2d/default_gravity=980.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
environment/defaults/default_clear_color=Color(0.027451, 0.031373, 0.078431, 1)
